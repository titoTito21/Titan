# The Elten API bridge - the few words that are Titan's own.
#
# Almost nothing here needs translating: every label, header and prompt an
# application shows comes from the application, already translated by its
# own catalogue. These are the handful of controls and questions the bridge
# builds itself - the player's transport, the file tree's own menu, and
# what it asks before it changes somebody's disk.
msgid ""
msgstr ""
"Project-Id-Version: elten_bridge\n"
"Language: pl\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Play"
msgstr "Odtwórz"

