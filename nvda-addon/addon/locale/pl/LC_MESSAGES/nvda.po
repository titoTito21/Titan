#. Translators: a row of a kind's rule: braille.
#: schemeWalk.py:362
msgid "In braille, the type is shown as: {word}"
msgstr "W brajlu typ jest pokazywany jako: {word}"

#. Translators: marks the sound in force.
#: schemeWalk.py:501
msgid "now"
msgstr "teraz"

#. Translators: a row of a kind's rule: the voice of one part.
#: schemeWalk.py:353
msgid "Voice of the {part}: {voice}"
msgstr "Głos części {part}: {voice}"

#. Translators: a row of a kind's rule: a part shown in braille.
#: schemeWalk.py:372
msgid "In braille, the {part}: {state}"
msgstr "W brajlu, {part}: {state}"

#. Translators: the type is not shown in braille.
#: schemeWalk.py:365
msgid "nothing"
msgstr "nic"

#. Translators: a control state, in the sound scheme manager.
#: schemes.py:104
msgid "ticked"
msgstr "zaznaczone"

#: schemes.py:105
msgid "partly ticked"
msgstr "częściowo zaznaczone"

#: schemes.py:107
msgid "expanded"
msgstr "rozwinięte"

#: schemes.py:108
msgid "collapsed"
msgstr "zwinięte"

#: schemes.py:109
msgid "pressed"
msgstr "wciśnięte"

#: schemes.py:111
msgid "read only"
msgstr "tylko do odczytu"

#. Translators: a control state - a menu item that opens a submenu.
#: schemes.py:114
msgid "has a submenu"
msgstr "ma podmenu"

#. Translators: a control state - a field that must be filled in.
#: schemes.py:116
msgid "required"
msgstr "wymagane"

#. Translators: a control state - a password field.
#: schemes.py:118
msgid "protected"
msgstr "chronione"

#. Translators: how a state is answered - in words, as NVDA does.
#: schemes.py:125
msgid "said as a word"
msgstr "mówione słowem"

#. Translators: how a state is answered - as a sound instead.
#: schemes.py:127
msgid "a sound instead of the word"
msgstr "dźwięk zamiast słowa"

#. Translators: how a state is answered - both.
#: schemes.py:129
msgid "a sound and the word"
msgstr "dźwięk i słowo"

#: semantics.py:122
msgid "note"
msgstr "notatka"

#: semantics.py:123
msgid "download"
msgstr "pobieranie"

#: semantics.py:124
msgid "reminder"
msgstr "przypomnienie"

#: semantics.py:125
msgid "voice"
msgstr "głos"

#. Translators: how a control's place is conveyed - as a pitch.
#: settingsPanel.py:48
msgid "a higher or lower voice (high at the top of the screen)"
msgstr "wyższy lub niższy głos (wysoko u góry ekranu)"

#. Translators: how a control's place is conveyed - by panning.
#: settingsPanel.py:51
msgid "the voice moved left or right"
msgstr "głos przesunięty w lewo lub w prawo"

#. Translators: how a control's place is conveyed - both ways at once.
#: settingsPanel.py:53
msgid "both"
msgstr "jedno i drugie"

#. Translators: which recogniser reads a window - Windows' own.
#: settingsPanel.py:55
msgid "Windows' own recogniser (free, nothing is sent)"
msgstr "rozpoznawanie tekstu w Windows (bezpłatnie, nic nie jest wysyłane)"

#. Translators: which recogniser reads a window - Titan's AI OCR.
#: settingsPanel.py:57
msgid "Titan's AI (understands it, sends a picture to your provider)"
msgstr "SI Titana (rozumie treść, wysyła obraz do twojego dostawcy)"

#. Translators: the layout of a walked list - row by row.
#: settingsPanel.py:60
msgid "simple (row by row)"
msgstr "prosty (wiersz po wierszu)"

#. Translators: the layout of a walked list - the arrows follow the screen.
#: settingsPanel.py:62
msgid "screen (the arrows follow the screen)"
msgstr "ekranowy (strzałki jak na ekranie)"

#. Translators: the layout of a walked list - Down enters, Up leaves.
#: settingsPanel.py:64
msgid "interaction (Down enters a control, Up leaves it)"
msgstr "interakcyjny (Dół wchodzi w element, Góra wychodzi)"

#. Translators: the title of the add-on's category in NVDA settings.
#: settingsPanel.py:384
msgid "Titan enhancements"
msgstr "Rozszerzenia Titana"

#. Translators: a group of settings in the Titan panel.
#: settingsPanel.py:80
msgid "Announcing controls"
msgstr "Oznajmianie kontrolek"

#. Translators: what the 'Announcing controls' category is for.
#: settingsPanel.py:82
msgid "How a control is read out: its name, what it is, its state, and what a picture or a dialog is called."
msgstr "Jak odczytywana jest kontrolka: jej nazwa, czym jest, jaki ma stan oraz jak nazywany jest obrazek lub okno dialogowe."

#. Translators: a group of settings in the Titan panel.
#: settingsPanel.py:134
msgid "Changes elsewhere"
msgstr "Zmiany w innym miejscu"

#. Translators: what the 'Changes elsewhere' category is for.
#: settingsPanel.py:136
msgid "What is said about something that changed while you were looking somewhere else."
msgstr "Co zostanie powiedziane o tym, co się zmieniło, gdy patrzysz w inne miejsce."

#. Translators: what the 'Sound' category is for.
#: settingsPanel.py:164
msgid "Sounds, and where in the stereo image the voice comes from."
msgstr "Dźwięki oraz to, skąd w obrazie stereo dobiega głos."

#. Translators: a group of settings in the Titan panel.
#: settingsPanel.py:197
msgid "Titan's announcements"
msgstr "Komunikaty Titana"

#. Translators: what the 'Titan's announcements' category is for.
#: settingsPanel.py:199
msgid "What Titan may say through NVDA, and how much of it may replace NVDA's own words."
msgstr "Co Titan może powiedzieć przez NVDA i w jakim stopniu może to zastąpić własne słowa NVDA."

#. Translators: a group of settings in the Titan panel. Its own
#. msgid rather than the layer entry's "Titan itself": the layer
#. opens the whole of Titan, and this group is only about the
#. settings inside it, so one word cannot serve both.
#: settingsPanel.py:230
msgid "Titan's own settings"
msgstr "Ustawienia Titana"

#. Translators: what the "Titan's own settings" category is for.
#: settingsPanel.py:232
msgid "The list of Titan you walk with the arrow keys - what it can start, its settings, its macros. Enter on a setting changes it; Save is at the end of the categories."
msgstr "Lista Titana, po której chodzisz strzałkami: co może uruchomić, jego ustawienia, jego makra. Enter na ustawieniu zmienia je, a Zapisz jest na końcu listy kategorii."

#. Translators: a group of settings in the Titan panel.
#: settingsPanel.py:243
msgid "Virtual machines"
msgstr "Maszyny wirtualne"

#. Translators: what the 'Virtual machines' category is for.
#: settingsPanel.py:245
msgid "A guest is another computer's screen, so there is nothing in it for a reader to read. This follows the pointer instead: what is written on its row, and what the pointer's own shape says the control is. No key to press, and nothing is installed in the guest."
msgstr "Gość to ekran innego komputera, więc czytnik ekranu nie ma w nim czego czytać. Zamiast tego śledzony jest wskaźnik myszy: co jest napisane w jego wierszu i co o kontrolce mówi sam kształt wskaźnika. Nie trzeba nic naciskać i nic nie jest instalowane w systemie gościa."

#. Translators: a group of settings in the Titan panel.
#: settingsPanel.py:274
msgid "Permissions"
msgstr "Uprawnienia"

#. Translators: text on the Titan enhancements panel.
#: settingsPanel.py:276
msgid "What NVDA can see is always answered: it is your own screen, described to your own desktop, and it is what lets Titan read the window you are really in."
msgstr "To, co widzi NVDA, jest udostępniane zawsze: to twój własny ekran, opisywany twojemu własnemu pulpitowi, i właśnie dzięki temu Titan czyta okno, w którym naprawdę jesteś."

#. Translators: a group of settings in the Titan panel.
#: settingsPanel.py:290
msgid "Unreadable windows"
msgstr "Okna, których nie da się odczytać"

#. Translators: text on the Titan enhancements panel.
#: settingsPanel.py:292
msgid "These need Titan running with its AI features on, and both send a picture of part of your screen to your AI provider - which is why they start off. A window is only ever read after you have been asked about that program."
msgstr "Te dwie funkcje wymagają uruchomionego Titana z włączonymi funkcjami SI i obie wysyłają obraz fragmentu twojego ekranu do twojego dostawcy SI - dlatego są domyślnie wyłączone. Okno zostanie odczytane dopiero wtedy, gdy potwierdzisz to dla danego programu."

#. Translators: a group of settings in the Titan panel.
#: settingsPanel.py:321
msgid "Terminal"
msgstr "Terminal"

#. Translators: text on the Titan enhancements panel.
#: settingsPanel.py:323
msgid "Numpad minus turns the review on and off. While it is on the plain arrow keys walk the buffer - lines with up and down, characters with left and right, a screenful with page up and page down - and each line is marked by a short beep pitched by where it is on the screen. Escape leaves."
msgstr "Minus na klawiaturze numerycznej włącza i wyłącza przegląd. Gdy jest włączony, zwykłe strzałki chodzą po buforze: w górę i w dół po wierszach, w lewo i w prawo po znakach, Page Up i Page Down o cały ekran. Każdy wiersz jest oznaczany krótkim dźwiękiem, którego wysokość zależy od położenia wiersza na ekranie. Escape wychodzi."

#. Translators: text on the Titan enhancements panel.
#: settingsPanel.py:331
msgid "NVDA and the wheel to the right turns it on, to the left turns it off - which a touchpad can do with two fingers."
msgstr "NVDA i kółko myszy w prawo włącza, w lewo wyłącza - gładzik potrafi to zrobić dwoma palcami."

#. Translators: a group of settings in the Titan panel.
#: settingsPanel.py:339
msgid "Walked lists"
msgstr "Listy przeglądane"

#. Translators: what the 'Walked lists' category is for.
#: settingsPanel.py:341
msgid "The palette, a message, the virtual window and the managers: lists the arrows walk."
msgstr "Paleta, komunikat, okno wirtualne i menedżery: listy, po których chodzą strzałki."

#: settingsPanel.py:418
msgid "&Categories"
msgstr "&Kategorie"

#. Translators: the name of the explanation in the key dialog.
#: settingsPanel.py:594
msgid "What the key is for"
msgstr "Do czego jest ten klucz"

#. Translators: the name of the field holding the agent's key.
#: settingsPanel.py:602
msgid "The agent's key"
msgstr "Klucz agenta"

#. Translators: the first entry of the OCR language list - whatever
#. Windows is set to.
#: settingsPanel.py:725
msgid "(whatever Windows is set to)"
msgstr "(zgodnie z ustawieniem Windows)"

#: settingsPanel.py:86
msgid "Read Titan's controls the way Titan Access does: the name, then the control type a little lower, then the state a little higher"
msgstr "Czytaj kontrolki Titana tak, jak robi to Titan Access: nazwa, potem typ kontrolki nieco niżej, potem stan nieco wyżej"

#: settingsPanel.py:91
msgid "Read every control that way, in every program - not only in Titan"
msgstr "Czytaj tak każdą kontrolkę, w każdym programie - nie tylko w Titanie"

#: settingsPanel.py:95
msgid "Read Titan's own applications as what they are: a row of the file manager as a file or a folder with its date and type, a note as a note"
msgstr "Czytaj własne aplikacje Titana jako to, czym są: wiersz menedżera plików jako plik lub folder z datą i typem, notatkę jako notatkę"

#: settingsPanel.py:100
msgid "Read every other program that way too: a row of a list with the columns beside its name, and a part of the window NVDA enters in silence"
msgstr "Czytaj tak też każdy inny program: wiersz listy z kolumnami obok nazwy oraz część okna, w którą NVDA wchodzi w ciszy"

#: settingsPanel.py:105
msgid "Use the reader modules: what each program's own lists, panes and rows mean"
msgstr "Używaj modułów czytnika: co znaczą własne listy, panele i wiersze każdego programu"

#: settingsPanel.py:109
msgid "Say what a picture is - an icon, a picture, an animation - instead of \"graphic\""
msgstr "Mów, czym jest obraz - ikona, obraz, animacja - zamiast \"grafika\""

#: settingsPanel.py:113
msgid "Say what kind of dialog it is - a question, a warning, an error - anywhere in Windows"
msgstr "Mów, jakiego rodzaju jest okno dialogowe - pytanie, ostrzeżenie, błąd - w całym systemie Windows"

#: settingsPanel.py:118
msgid "Say what kind of window you have arrived in - an application, a game, a small window, the desktop - and what its icon is"
msgstr "Mów, w jakim oknie jesteś - aplikacja, gra, okienko, pulpit - i co przedstawia jego ikona"

#: settingsPanel.py:121
msgid "Say when the keyboard leaves a menu"
msgstr "Mów, gdy klawiatura opuszcza menu"

#: settingsPanel.py:124
msgid "Answer a control's state with a sound where you have chosen one, instead of the word (set them under Sound scheme)"
msgstr "Oznajmiaj stan kontrolki dźwiękiem tam, gdzie go wybrano, zamiast słowem (ustawia się je w Schemacie dźwiękowym)"

#: settingsPanel.py:129
msgid "Give keyboard echo, a spelled word, a message and what another program says through the controller a voice of their own (set them under Voices and reading order)"
msgstr "Nadaj własny głos echu klawiatury, literowanemu słowu, komunikatowi oraz temu, co mówi inny program przez kontroler (ustawia się je w oknie Głosy i kolejność odczytu)"

#: settingsPanel.py:140
msgid "Announce live regions - anything a reader module or Titan declares live"
msgstr "Ogłaszaj obszary dynamiczne - wszystko, co moduł czytnika lub Titan zgłosi jako dynamiczne"

#: settingsPanel.py:144
msgid "Including the status bar of the window you are in"
msgstr "W tym pasek stanu okna, w którym jesteś"

#: settingsPanel.py:148
msgid "Say when the program is busy (the hourglass)"
msgstr "Mów, gdy program jest zajęty (klepsydra)"

#: settingsPanel.py:151
msgid "Say when a window asks for your attention"
msgstr "Mów, gdy okno prosi o uwagę"

#: settingsPanel.py:154
msgid "Watch the areas you have marked, and say when one changes"
msgstr "Obserwuj zaznaczone obszary i mów, gdy któryś się zmieni"

#: settingsPanel.py:158
msgid "Keep what the reader has said, so you can look back at it and go to what said it"
msgstr "Zapamiętuj to, co czytnik powiedział, aby można było do tego wrócić i przejść do tego, co to powiedziało"

#: settingsPanel.py:167
msgid "Place the voice where the control is, in Titan"
msgstr "Umieszczaj głos tam, gdzie jest kontrolka, w Titanie"

#. Translators: a setting in the Titan enhancements panel: how a
#. control's place is conveyed.
#: settingsPanel.py:170
msgid "Carry that place as:"
msgstr "Przekazuj to położenie jako:"

#: settingsPanel.py:173
msgid "Place it that way everywhere else too, in every program"
msgstr "Umieszczaj tak również wszędzie indziej, w każdym programie"

#: settingsPanel.py:177
msgid "When the voice cannot be placed, mark the position with a tone"
msgstr "Gdy głosu nie da się umieścić, oznacz położenie dźwiękiem"

#: settingsPanel.py:181
msgid "Play Titan's own cursor sounds on every control, outside Titan's own windows (they already play their own)"
msgstr "Odtwarzaj własne dźwięki kursora Titana na każdej kontrolce, poza własnymi oknami Titana (te odtwarzają swoje)"

#: settingsPanel.py:185
msgid "Play a short sound for what just happened - on a button, something opened, that was refused"
msgstr "Odtwarzaj krótki dźwięk tego, co się właśnie stało - przycisk, coś się otworzyło, odmowa"

#: settingsPanel.py:189
msgid "Play them on every control in every program, not only in Titan's own windows"
msgstr "Odtwarzaj je na każdej kontrolce w każdym programie, nie tylko w oknach Titana"

#: settingsPanel.py:193
msgid "Say what a shortcut does as it is pressed - Control+O, \"Open\" - read out of the program's own menu"
msgstr "Mów, co robi skrót klawiszowy, gdy jest naciskany - Control+O, \"Otwórz\" - odczytane z własnego menu programu"

#: settingsPanel.py:203
msgid "Let Titan make its own announcements through NVDA"
msgstr "Pozwól Titanowi wygłaszać własne komunikaty przez NVDA"

#: settingsPanel.py:206
msgid "Let one of them replace NVDA's own report of that control"
msgstr "Pozwól, aby taki komunikat zastąpił własny odczyt kontrolki przez NVDA"

#: settingsPanel.py:210
msgid "Apply the pitch, rate and volume Titan asks for"
msgstr "Stosuj wysokość, prędkość i głośność, o które prosi Titan"

#. Translators: a setting in the Titan enhancements panel.
#: settingsPanel.py:213
msgid "Show Titan's announcements in braille"
msgstr "Pokazuj komunikaty Titana na brajlu"

#: settingsPanel.py:217
msgid "Stay silent while Titan Access is the reader"
msgstr "Milcz, gdy czytnikiem jest Titan Access"

#: settingsPanel.py:220
msgid "Say when Titan connects and disconnects"
msgstr "Mów, gdy Titan łączy się i rozłącza"

#: settingsPanel.py:223
msgid "Tell Titan which program you are in, so its own features can be about that program"
msgstr "Mów Titanowi, w jakim programie jesteś, żeby jego funkcje dotyczyły tego programu"

#. Translators: a setting in the Titan enhancements panel.
#: settingsPanel.py:236
msgid "Say what a setting is set to"
msgstr "Mów, jaka jest wartość ustawienia"

#. Translators: a setting in the Titan enhancements panel.
#: settingsPanel.py:238
msgid "Say how many are in a list"
msgstr "Mów, ile jest pozycji na liście"

#. Translators: a setting in the Titan enhancements panel.
#: settingsPanel.py:240
msgid "Save Titan's settings straight away"
msgstr "Zapisuj ustawienia Titana od razu"

#. Translators: a setting in the Titan enhancements panel.
#: settingsPanel.py:251
msgid "Read what the pointer is on"
msgstr "Czytaj, na czym stoi wskaźnik"

#: settingsPanel.py:256
msgid "Read programs that draw their own controls (Tkinter, games)"
msgstr "Czytaj programy, które same rysują kontrolki (Tkinter, gry)"

#: settingsPanel.py:263
msgid "Also listen for an agent inside a guest or a game telling the reader what it sees. Nothing is needed in the guest for the pointer above; this is for real text, where you can put something there"
msgstr "Nasłuchuj także agenta w gościu lub w grze, który mówi czytnikowi, co widzi. Dla wskaźnika powyżej nie trzeba niczego w gościu; to jest po prawdziwy tekst, tam gdzie da się coś umieścić"

#: settingsPanel.py:269
msgid "Let such an agent reach the reader over the network. Without this it is heard only from this computer, or through VMware itself, which needs no network at all"
msgstr "Pozwól takiemu agentowi dotrzeć do czytnika przez sieć. Bez tego jest słyszany tylko z tego komputera albo przez samo VMware, które nie wymaga sieci"

#: settingsPanel.py:281
msgid "Let Titan change NVDA - its voice, its review cursor, its rate and its settings"
msgstr "Pozwól Titanowi zmieniać NVDA - jego głos, kursor przeglądu, prędkość i ustawienia"

#: settingsPanel.py:285
msgid "Let Titan run NVDA's own commands. A command is whatever you bound that key to, so this is off until you turn it on"
msgstr "Pozwól Titanowi uruchamiać własne polecenia NVDA. Polecenie to cokolwiek przypisano do danego klawisza, dlatego jest to wyłączone, dopóki tego nie włączysz"

#: settingsPanel.py:298
msgid "Read a window that exposes nothing - a game's menu, an installer that draws its own widgets - and give it real controls you can Tab through, or follow what is highlighted if it is a game"
msgstr "Czytaj okno, które nic nie udostępnia - menu gry, instalator rysujący własne kontrolki - i nadaj mu prawdziwe kontrolki, po których chodzi się tabulatorem, albo śledź podświetlenie, jeśli to gra"

#: settingsPanel.py:304
msgid "Work out a name for an unnamed control by reading it once, and remember it"
msgstr "Ustal nazwę nienazwanej kontrolki, odczytując ją raz, i zapamiętaj ją"

#: settingsPanel.py:310
msgid "Read what the program drew, before taking any picture of it (exact, instant, and nothing leaves the machine)"
msgstr "Czytaj to, co program narysował, przed zrobieniem jakiegokolwiek zdjęcia (dokładnie, natychmiast i nic nie opuszcza tej maszyny)"

#. Translators: a setting in the Titan enhancements panel: which
#. recogniser reads a window that shows a screen reader nothing.
#: settingsPanel.py:314
msgid "Read such a window with:"
msgstr "Czytaj takie okno za pomocą:"

#: settingsPanel.py:317
msgid "The language Windows' own recogniser reads in:"
msgstr "Język, w którym czyta rozpoznawanie tekstu Windows:"

#: settingsPanel.py:335
msgid "Use the laptop's touchpad as a touch screen, so NVDA's own touch gestures work on it"
msgstr "Używaj gładzika laptopa jak ekranu dotykowego, aby działały na nim własne gesty dotykowe NVDA"

#. Translators: a setting in the Titan enhancements panel.
#: settingsPanel.py:344
msgid "Layout of the walked lists:"
msgstr "Układ list przeglądanych:"

#: settingsPanel.py:347
msgid "Say the kind of a row (page, category, check box)"
msgstr "Mów rodzaj wiersza (strona, kategoria, pole wyboru)"

#. Translators: a setting in the Titan enhancements panel.
#: settingsPanel.py:349
msgid "Say the place in the list (3 of 12)"
msgstr "Mów miejsce na liście (3 z 12)"

#. Translators: a setting in the Titan enhancements panel.
#: settingsPanel.py:351
msgid "Say the list's title on opening"
msgstr "Mów tytuł listy przy otwarciu"

#: settingsPanel.py:354
msgid "A tone per row, pitched by how far down the list it is"
msgstr "Ton przy każdym wierszu, wysokością mówiący, jak daleko w liście"

#. Translators: a setting in the Titan enhancements panel.
#: settingsPanel.py:356
msgid "Past the last row, round to the first"
msgstr "Za ostatnim wierszem wracaj do pierwszego"

#: settingsPanel.py:359
msgid "A walked list has a window of its own that holds the keyboard"
msgstr "Lista przeglądana ma własne okno, które trzyma klawiaturę"

#. Translators: a button on the Titan enhancements panel.
#: settingsPanel.py:436
msgid "Reader modules..."
msgstr "Moduły czytnika..."

#. Translators: a button on the Titan enhancements panel: shows
#. the key an agent inside a guest has to carry.
#: settingsPanel.py:440
msgid "The agent's key..."
msgstr "Klucz agenta..."

#. Translators: text in the dialog showing the agent's key.
#: settingsPanel.py:585
msgid "An agent must carry this key in every line it sends, or the reader drops it without answering. Copy it into the agent; it never leaves this computer otherwise. The agent talks to port {port}."
msgstr "Agent musi nieść ten klucz w każdej wysyłanej linii, inaczej czytnik porzuca ją bez odpowiedzi. Skopiuj go do agenta; poza tym nie opuszcza tego komputera. Agent rozmawia na porcie {port}."

#: settingsPanel.py:626
msgid "This NVDA cannot place the voice of the current synthesizer: {reason}"
msgstr "Ten NVDA nie potrafi umieścić w przestrzeni głosu bieżącego syntezatora: {reason}"

#. Translators: the label of the field holding the agent's key.
#: settingsPanel.py:597
msgid "&Key"
msgstr "&Klucz"

#: settingsPanel.py:623
msgid "This NVDA can place the voice of the current synthesizer ({name})."
msgstr "Ten NVDA potrafi umieścić w przestrzeni głos bieżącego syntezatora ({name})."

#: settingsPanel.py:628
msgid "the reason is unknown"
msgstr "przyczyna nieznana"

#: settingsPanel.py:492
msgid "{category}: switches"
msgstr "{category}: przełączniki"

#. Translators: said when an unreadable window has been read as a
#. picture and its controls can now be walked with Tab and the
#. arrows.
#: smart.py:222
msgid "Window recognised, Native TCE cursor"
msgstr "Rozpoznano okno, Native TCE cursor"

#. Translators: said when that stops.
#: smart.py:224
msgid "Native TCE cursor off"
msgstr "Native TCE cursor wyłączony"

#: smart.py:502
msgid "There is nothing to press."
msgstr "Nie ma czego nacisnąć."

#: smart.py:603
msgid "That control has no place on the screen."
msgstr "Ta kontrolka nie ma miejsca na ekranie."

#. Translators: said when a control read from the screen is pressed.
#: smart.py:635
msgid "Pressed {name}."
msgstr "Naciśnięto {name}."

#: smart.py:329
msgid "{index} of {count}"
msgstr "{index} z {count}"

#. Translators: said when a control read from the screen is
#. double-clicked.
#: smart.py:633
msgid "Double-clicked {name}."
msgstr "Kliknięto dwukrotnie {name}."

#. Translators: a kind of control, in the speech scheme editor.
#: speechSchemes.py:171
msgid "Buttons"
msgstr "Przyciski"

#: speechSchemes.py:172
msgid "Check boxes"
msgstr "Pola wyboru"

