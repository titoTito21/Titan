msgstr "NVDA nie zna gestu {name}."

#. Translators: said when the OCR review starts.
#: ocrReview.py:100
msgid "Screen review on"
msgstr "Przeglądanie ekranu włączone"

#. Translators: said when the OCR review ends.
#: ocrReview.py:110
msgid "Screen review off"
msgstr "Przeglądanie ekranu wyłączone"

#. Translators: said when there is no window to read.
#: ocrReview.py:83
msgid "There is no window to read"
msgstr "Nie ma okna do odczytania"

#. Translators: said when a re-read found nothing.
#: ocrReview.py:123
msgid "Nothing could be read this time"
msgstr "Tym razem nic nie udało się odczytać"

#. Translators: said when there is nothing under the review cursor.
#: ocrReview.py:255
msgid "There is nothing here to click"
msgstr "Nie ma tu w co kliknąć"

#. Translators: said when Windows read nothing.
#: ocrReview.py:88
msgid "Windows read nothing in that window"
msgstr "Windows nie odczytał niczego w tym oknie"

#. Translators: said when the screen has been read again. {n} is how many
#. lines it found.
#: ocrReview.py:132
msgid "{n} lines"
msgstr "Wierszy: {n}"

#. Translators: said when the command palette is closed.
#: palette.py:249
