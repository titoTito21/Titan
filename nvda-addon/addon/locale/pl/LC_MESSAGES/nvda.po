msgstr "Paleta zamknięta"

#. Translators: a named voice overlay, in the voice class manager.
#: personalities.py:80
msgid "the reader's own voice, unchanged"
msgstr "własny głos czytnika, bez zmian"

#. Translators: a named voice overlay.
#: personalities.py:82
msgid "bolder - lower and louder, the way bold text reads"
msgstr "grubszy - niżej i głośniej, tak jak czyta się pogrubienie"

#: personalities.py:83
msgid "bolder, a little"
msgstr "grubszy, trochę"

#: personalities.py:84
msgid "bolder, a lot"
msgstr "grubszy, mocno"

#. Translators: a named voice overlay.
#: personalities.py:86
msgid "lighter - higher and quieter, for what matters less"
msgstr "lżejszy - wyżej i ciszej, dla tego, co mniej ważne"

#: personalities.py:87
msgid "lighter, a little"
msgstr "lżejszy, trochę"

#: personalities.py:88
msgid "lighter, a lot"
msgstr "lżejszy, mocno"

#. Translators: a named voice overlay.
#: personalities.py:90
msgid "livelier - more inflection, for something to act on"
msgstr "żywszy - więcej intonacji, dla tego, na co trzeba zareagować"

#: personalities.py:91
msgid "livelier, a little"
msgstr "żywszy, trochę"

#: personalities.py:92
msgid "livelier, a lot"
msgstr "żywszy, mocno"

#. Translators: a named voice overlay.
#: personalities.py:94
msgid "flatter - less inflection, for what is unavailable"
msgstr "płaski - mniej intonacji, dla tego, co niedostępne"

#: personalities.py:95
msgid "flatter, a little"
msgstr "płaski, trochę"

#: personalities.py:96
msgid "flat, with no inflection at all"
msgstr "zupełnie płaski, bez intonacji"

#. Translators: a named voice overlay.
#: personalities.py:98
msgid "smoother - flatter and slower"
msgstr "gładszy - płasko i wolniej"

#. Translators: a named voice overlay.
#: personalities.py:100
msgid "brighter - higher and livelier"
msgstr "jaśniejszy - wyżej i żywiej"

#. Translators: a named voice overlay.
#: personalities.py:102
msgid "an aside - higher, quicker, quieter"
msgstr "uwaga na boku - wyżej, szybciej, ciszej"

#. Translators: a named voice overlay.
#: personalities.py:104
msgid "set back - lower, quicker, quieter"
msgstr "cofnięty - niżej, szybciej, ciszej"

#. Translators: said when recording a procedure starts.
#: procedures.py:206
msgid "Recording on"
msgstr "Nagrywanie włączone"

#. Translators: said when a recording is thrown away.
#: procedures.py:241
msgid "Recording thrown away"
msgstr "Nagranie wyrzucone"

#. Translators: said when a recording had no steps in it.
#: procedures.py:222
msgid "Nothing was recorded"
msgstr "Nic nie nagrano"

#. Translators: said when a procedure has no steps.
#: procedures.py:390
msgid "There is nothing in that procedure"
msgstr "W tej procedurze nic nie ma"

#. Translators: said when a recording is already running.
#: procedures.py:202
msgid "Already recording"
msgstr "Już nagrywam"

#. Translators: the default name of a recorded procedure. {n} is how
#. many steps it has.
#: procedures.py:226
msgid "Procedure of {n} steps"
msgstr "Procedura z {n} krokami"

#. Translators: said when a procedure is kept. {what} is its name, {n}
#. how many steps.
#: procedures.py:232
msgid "Kept {what}, {n} steps"
msgstr "Zapisano: {what}, kroków: {n}"

#. Translators: a step of a procedure. {what} is a control.
#: procedures.py:330
msgid "go to {what}"
msgstr "przejdź do: {what}"

#. Translators: a step of a procedure. {what} is a control.
#: procedures.py:333
msgid "press {what}"
msgstr "naciśnij: {what}"

#. Translators: a step of a procedure. {text} is what is typed.
#: procedures.py:336
msgid "type \"{text}\""
msgstr "wpisz \"{text}\""

#. Translators: a step of a procedure. {key} is a key.
#: procedures.py:339
msgid "press the key {key}"
msgstr "naciśnij klawisz {key}"

#. Translators: a step of a procedure. {what} is a control.
#: procedures.py:342
msgid "wait for {what}"
msgstr "czekaj na: {what}"

#. Translators: said when a procedure has finished. {what} is its name.
#: procedures.py:415
msgid "{what}: done"
msgstr "{what}: gotowe"

#: procedures.py:404
msgid "{n}. {what}"
msgstr "{n}. {what}"

#: procedures.py:468
msgid "Step {n} could not be done"
msgstr "Nie udało się wykonać kroku {n}"

#. Translators: said when a procedure took too long. {n} is the
#. step it had reached.
#: procedures.py:402
msgid "It is taking too long; stopped at step {n}"
msgstr "Trwa to za długo; zatrzymano na kroku {n}"

#. Translators: said when a step's control is not there. {n} is
#. the step's number, {what} the control.
#: procedures.py:425
msgid "Step {n}: {what} is not there"
msgstr "Krok {n}: nie ma tu {what}"

#. Translators: said when a step could not type. {n} is the step.
#: procedures.py:487
msgid "Step {n}: the text could not be typed"
msgstr "Krok {n}: nie udało się wpisać tekstu"

#. Translators: said when a step's key could not be sent. {n} is the
#. step, {key} the key.
#: procedures.py:498
msgid "Step {n}: the key {key} could not be sent"
msgstr "Krok {n}: nie udało się wysłać klawisza {key}"

#: sayall_profile.py:203
msgid "Text will be read with the synthesizer NVDA is using."
msgstr "Tekst będzie czytany syntezatorem, którego używa NVDA."

#: sayall_profile.py:176
msgid "NVDA has no configuration folder, so a voice for reading text cannot be kept."
msgstr "NVDA nie ma folderu konfiguracji, więc nie da się zapamiętać głosu do czytania tekstu."

#: sayall_profile.py:183
msgid "The profile could not be written."
msgstr "Nie udało się zapisać profilu."

#: sayall_profile.py:185
msgid "The profile was written but NVDA would not be told to use it for reading text."
msgstr "Profil został zapisany, ale nie udało się powiedzieć NVDA, żeby używał go do czytania tekstu."

#: sayall_profile.py:187
msgid "Text will be read with {synth}. NVDA does the switching itself, through a configuration profile called \"{name}\" that you can see and remove in its own Configuration Profiles dialog."
msgstr "Tekst będzie czytany syntezatorem {synth}. NVDA przełącza się sam, przez profil konfiguracji o nazwie \"{name}\", który widzisz i możesz usunąć we własnym oknie Profile konfiguracji."

#: sayall_profile.py:179
msgid "There is already a profile called \"{name}\" that this add-on did not write, so it has been left alone."
msgstr "Istnieje już profil o nazwie \"{name}\", którego ten dodatek nie zapisał, więc został nietknięty."

