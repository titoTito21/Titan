# Titan enhancements - PL.
#
# Written from the add-on's own sources by update_catalogue.py: every string
# it can say has an entry. gettext falls back to the English source for an
# empty one, so a catalogue that has fallen behind the code is a partial
# translation rather than a broken one.
msgid ""
msgstr ""
"Project-Id-Version: titanEnhancements\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: pl\n"
"Plural-Forms: nplurals=3; plural=(n==1 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"


#: __init__.py:547
msgid "In a virtual machine, a game or a window that draws itself: say what the key moved onto"
msgstr "W maszynie wirtualnej, grze lub oknie, które rysuje się samo: powiedz, na co przeniosło się zaznaczenie"

#: __init__.py:717
msgid "In a described application: type into the field"
msgstr "W opisanej aplikacji: pisz w polu edycji"

#: __init__.py:860
msgid "In a walked list: the trackpad - explore with a finger, flick to move, more fingers for the corners, the layout and the ends"
msgstr "W przeglądanej liście: gładzik - eksploracja palcem, machnięcie przesuwa, więcej palców to rogi, układ i końce"

#: __init__.py:903
msgid "In the application: the top left corner - the first control"
msgstr "W aplikacji: lewy górny róg - pierwsza kontrolka"

#: __init__.py:908
msgid "In the application: the top right corner - the end of the first control"
msgstr "W aplikacji: prawy górny róg - koniec pierwszej kontrolki"

#: __init__.py:913
msgid "In the application: the bottom left corner - the last control"
msgstr "W aplikacji: lewy dolny róg - ostatnia kontrolka"

#: __init__.py:918
msgid "In the application: the bottom right corner - the end of the last control"
msgstr "W aplikacji: prawy dolny róg - koniec ostatniej kontrolki"

#: __init__.py:923
msgid "In the application: the next arrow layout"
msgstr "W aplikacji: następny układ strzałek"

#: __init__.py:934
msgid "In the application: the previous arrow layout"
msgstr "W aplikacji: poprzedni układ strzałek"

#: __init__.py:945
msgid "In the screen review: the top left corner - the start of the first line"
msgstr "W przeglądzie ekranu: lewy górny róg - początek pierwszego wiersza"

#: __init__.py:950
msgid "In the screen review: the top right corner - the end of the first line"
msgstr "W przeglądzie ekranu: prawy górny róg - koniec pierwszego wiersza"

#: __init__.py:955
msgid "In the screen review: the bottom left corner - the start of the last line"
msgstr "W przeglądzie ekranu: lewy dolny róg - początek ostatniego wiersza"

#: __init__.py:960
msgid "In the screen review: the bottom right corner - the end of the last line"
msgstr "W przeglądzie ekranu: prawy dolny róg - koniec ostatniego wiersza"

#: __init__.py:965
msgid "In the screen review: the next arrow layout"
msgstr "W przeglądzie ekranu: następny układ strzałek"

#: __init__.py:976
msgid "In the screen review: the previous arrow layout"
msgstr "W przeglądzie ekranu: poprzedni układ strzałek"

#: __init__.py:987
msgid "In the command palette: the command above - or, in the interaction layout, out of this row"
msgstr "W palecie poleceń: polecenie wyżej - lub, w układzie z interakcją, wyjście z tego wiersza"

#: __init__.py:993
msgid "In the command palette: the command below - or, in the interaction layout, into this row"
msgstr "W palecie poleceń: polecenie niżej - lub, w układzie z interakcją, wejście w ten wiersz"

#: __init__.py:999
msgid "In the command palette: the first command"
msgstr "W palecie poleceń: pierwsze polecenie"

#: __init__.py:1004
msgid "In the command palette: the last command"
msgstr "W palecie poleceń: ostatnie polecenie"

#: __init__.py:1009
msgid "In the command palette: run this command"
msgstr "W palecie poleceń: wykonaj to polecenie"

#: __init__.py:1025
msgid "In the palette: back through the row - a character, the word beside, or the row beside, by layout"
msgstr "W palecie: wstecz przez wiersz - znak, słowo obok lub wiersz obok, zależnie od układu"

#: __init__.py:1031
msgid "In the palette: on through the row - a character, the word beside, or the row beside, by layout"
msgstr "W palecie: dalej przez wiersz - znak, słowo obok lub wiersz obok, zależnie od układu"

#: __init__.py:1037
msgid "In the palette: the other way through the row - the word beside in the simple layout, a character in the others"
msgstr "W palecie: wstecz na drugi sposób - słowo obok w układzie prostym, znak w pozostałych"

#: __init__.py:1043
msgid "In the palette: the other way on through the row - the word beside in the simple layout, a character in the others"
msgstr "W palecie: dalej na drugi sposób - słowo obok w układzie prostym, znak w pozostałych"

#: __init__.py:1049
msgid "In the palette: the top left corner - the start of the first row"
msgstr "W palecie: lewy górny róg - początek pierwszego wiersza"

#: __init__.py:1054
msgid "In the palette: the top right corner - the end of the first row"
msgstr "W palecie: prawy górny róg - koniec pierwszego wiersza"

#: __init__.py:1059
msgid "In the palette: the bottom left corner - the start of the last row"
msgstr "W palecie: lewy dolny róg - początek ostatniego wiersza"

#: __init__.py:1064
msgid "In the palette: the bottom right corner - the end of the last row"
msgstr "W palecie: prawy dolny róg - koniec ostatniego wiersza"

#: __init__.py:1069
msgid "In the palette: the next layout - simple, screen, interaction; shared with the virtual window"
msgstr "W palecie: następny układ - prosty, ekranu, z interakcją; wspólny z wirtualnym oknem"

#: __init__.py:1075
msgid "In the palette: the previous layout - simple, screen, interaction; shared with the virtual window"
msgstr "W palecie: poprzedni układ - prosty, ekranu, z interakcją; wspólny z wirtualnym oknem"

#: __init__.py:1081
msgid "In the palette: the word before, in this command's name"
msgstr "W palecie: poprzednie słowo w nazwie tego polecenia"

#: __init__.py:1086
msgid "In the palette: the word after, in this command's name"
msgstr "W palecie: następne słowo w nazwie tego polecenia"

#: __init__.py:1090
msgid "In the command palette: back one level, or close it"
msgstr "W palecie poleceń: poziom wyżej lub zamknij"

#: __init__.py:1184
msgid "In the virtual window: type into the field"
msgstr "W wirtualnym oknie: pisz w polu edycji"

#. Translators: an NVDA command.
#: __init__.py:1438
msgid "Reports whether Titan is connected and what it can send to this NVDA"
msgstr "Mówi, czy Titan jest połączony i co potrafi wysłać do tego NVDA"

#. Translators: an NVDA command.
#: __init__.py:1446
msgid "Opens the Titan menu: everything Titan can do"
msgstr "Otwiera menu Titana: wszystko, co Titan potrafi"

#. Translators: an NVDA command.
#: __init__.py:1458
msgid "Runs one of the macros in Titan"
msgstr "Uruchamia jedno z makr Titana"

#. Translators: an NVDA command.
#: __init__.py:1465
msgid "Runs anything Titan or one of its add-ons can do"
msgstr "Uruchamia dowolną akcję Titana lub jego dodatku"

#. Translators: an NVDA command.
#: __init__.py:1472
msgid "Reads the current window with Titan's AI OCR"
msgstr "Odczytuje bieżące okno przez AI OCR Titana"

#. Translators: an NVDA command.
#: __init__.py:1479
msgid "Asks Titan's AI a question about the current window"
msgstr "Zadaje SI Titana pytanie o bieżące okno"

#. Translators: an NVDA command.
#: __init__.py:1486
msgid "Puts Titan's AI OCR overlay over the current window"
msgstr "Nakłada kontrolki AI OCR Titana na bieżące okno"

#. Translators: an NVDA command.
#: __init__.py:1493
msgid "Reads the last AI OCR reading again, without reading the screen afresh"
msgstr "Odczytuje ponownie ostatni odczyt AI OCR, bez ponownego czytania ekranu"

#. Translators: an NVDA command.
#: __init__.py:1501
msgid "Presses a control AI OCR read, by its name"
msgstr "Naciska kontrolkę odczytaną przez AI OCR, po jej nazwie"

#. Translators: an NVDA command.
#: __init__.py:1508
msgid "Sends a whole key to the window AI OCR read"
msgstr "Wysyła cały klawisz do okna odczytanego przez AI OCR"

#. Translators: an NVDA command.
#: __init__.py:1515
msgid "Asks Titan's AI assistant a question"
msgstr "Zadaje pytanie asystentowi SI Titana"

#. Translators: an NVDA command.
#: __init__.py:1522
msgid "Tells Titan's AI to do something, and lets it act"
msgstr "Zleca SI Titana zadanie i pozwala jej działać"

#. Translators: an NVDA command.
#: __init__.py:1529
msgid "Reads the conversation with Titan's AI assistant"
msgstr "Odczytuje rozmowę z asystentem SI Titana"

#. Translators: an NVDA command.
#: __init__.py:1536
msgid "Forgets the conversation with Titan's AI assistant"
msgstr "Zapomina rozmowę z asystentem SI Titana"

#. Translators: an NVDA command.
#: __init__.py:1543
msgid "Reads Titan's notifications"
msgstr "Odczytuje powiadomienia Titana"

#. Translators: an NVDA command.
#: __init__.py:1550
msgid "Reads a Titan buffer: what arrived while its window was closed"
msgstr "Odczytuje bufor Titana: to, co przyszło przy zamkniętym oknie"

#. Translators: an NVDA command.
#: __init__.py:1558
msgid "Says what Titan is showing right now"
msgstr "Mówi, co Titan właśnie pokazuje"

#. Translators: an NVDA command.
#: __init__.py:1565
msgid "Lists Titan's components"
msgstr "Wypisuje komponenty Titana"

#. Translators: an NVDA command.
#: __init__.py:1572
msgid "Asks Titan what it can do, so every one of its actions can be given a key in Input Gestures"
msgstr "Pyta Titana, co potrafi, aby każdej jego akcji można było przypisać klawisz w zdarzeniach wejścia"

#. Translators: an NVDA command.
#: __init__.py:1590
msgid "Read this window with Windows' own recogniser - no AI, nothing sent anywhere"
msgstr "Odczytaj to okno rozpoznawaniem tekstu Windows - bez SI, nic nie jest wysyłane"

#. Translators: an NVDA command.
#: __init__.py:1599
msgid "The windows, their controls, and what each control can do"
msgstr "Okna, ich kontrolki i to, co każda kontrolka potrafi"

#. Translators: an NVDA command.
#: __init__.py:1607
msgid "The manager: place markers, watched areas and the sound scheme"
msgstr "Menedżer: znaczniki miejsca, obserwowane obszary i schemat dźwiękowy"

#. Translators: an NVDA command.
#: __init__.py:1615
msgid "Run the add-on's own features here and say what worked"
msgstr "Uruchamia funkcje dodatku i mówi, co zadziałało"

#. Translators: an NVDA command.
#: __init__.py:1624
msgid "Read this window and walk it with the arrow keys; Enter clicks where you are"
msgstr "Odczytaj to okno i chodź po nim strzałkami; Enter klika tam, gdzie jesteś"

#: __init__.py:1644
msgid "In the screen review: the line above"
msgstr "W przeglądzie ekranu: wiersz wyżej"

#: __init__.py:1649
msgid "In the screen review: the line below"
msgstr "W przeglądzie ekranu: wiersz niżej"

#: __init__.py:1654
msgid "In the screen review: the word before"
msgstr "W przeglądzie ekranu: słowo wcześniej"

#: __init__.py:1659
msgid "In the screen review: the word after"
msgstr "W przeglądzie ekranu: słowo dalej"

#: __init__.py:1664
msgid "In the screen review: a screenful back"
msgstr "W przeglądzie ekranu: ekran wstecz"

#: __init__.py:1669
msgid "In the screen review: a screenful on"
msgstr "W przeglądzie ekranu: ekran naprzód"

#: __init__.py:1674
msgid "In the screen review: the start of the line"
msgstr "W przeglądzie ekranu: początek wiersza"

#: __init__.py:1679
msgid "In the screen review: the end of the line"
msgstr "W przeglądzie ekranu: koniec wiersza"

#. Translators: an NVDA command.
#: __init__.py:1686
msgid "In the screen review: click where you are"
msgstr "W przeglądzie ekranu: kliknij tam, gdzie jesteś"

#. Translators: an NVDA command.
#: __init__.py:1706
msgid "In the screen review: read the window again"
msgstr "W przeglądzie ekranu: odczytaj okno ponownie"

#. Translators: an NVDA command.
#: __init__.py:1720
msgid "Leave the screen review"
msgstr "Wyjdź z przeglądu ekranu"

#. Translators: an NVDA command.
#: __init__.py:1732
msgid "What the reader has said, and go back to what said it"
msgstr "Co czytnik powiedział - i powrót do tego, co to powiedziało"

#. Translators: an NVDA command.
#: __init__.py:1740
msgid "Find something the reader said, and go back to what said it"
msgstr "Znajdź coś, co czytnik powiedział, i wróć do tego, co to powiedziało"

#. Translators: an NVDA command.
#: __init__.py:1748
msgid "What the reader has said, as a page to read"
msgstr "Co czytnik powiedział, jako strona do przeczytania"

#. Translators: an NVDA command.
#: __init__.py:1756
msgid "Start recording what you do, or keep what was recorded"
msgstr "Zacznij nagrywać, co robisz, albo zapisz to, co nagrano"

#. Translators: an NVDA command.
#: __init__.py:1764
msgid "Throw away what is being recorded"
msgstr "Odrzuć to, co jest nagrywane"

#. Translators: an NVDA command.
#: __init__.py:1771
msgid "Do one of this program's recorded procedures again"
msgstr "Wykonaj ponownie jedną z nagranych procedur tego programu"

#. Translators: an NVDA command.
#: __init__.py:1778
msgid "Read the steps of a recorded procedure"
msgstr "Przeczytaj kroki nagranej procedury"

#. Translators: an NVDA command.
#: __init__.py:1786
msgid "Find a control in this window by its name or by what is written on the screen"
msgstr "Znajdź kontrolkę w tym oknie po nazwie albo po tym, co jest napisane na ekranie"

#. Translators: an NVDA command.
#: __init__.py:1794
msgid "Find a control by what it DOES, using the AI"
msgstr "Znajdź kontrolkę po tym, CO ROBI, za pomocą SI"

#. Translators: an NVDA command.
#: __init__.py:1802
msgid "Mark the control you are on, so a key comes back to it"
msgstr "Zaznacz kontrolkę, na której jesteś, aby klawisz do niej wracał"

#. Translators: an NVDA command.
#: __init__.py:1810
msgid "Go to one of this program's place markers"
msgstr "Przejdź do jednego ze znaczników miejsca tego programu"

#. Translators: an NVDA command.
#: __init__.py:1817
msgid "Forget one of this program's place markers"
msgstr "Zapomnij jeden ze znaczników miejsca tego programu"

#. Translators: an NVDA command.
#: __init__.py:1824
msgid "Which state is answered with a sound instead of the word"
msgstr "Który stan jest oznajmiany dźwiękiem zamiast słowem"

#. Translators: an NVDA command.
#: __init__.py:1833
msgid "Watch the object the navigator is on, and say when it changes"
msgstr "Obserwuj obiekt, na którym jest nawigator, i mów, gdy się zmieni"

#. Translators: an NVDA command.
#: __init__.py:1841
msgid "Watch the area this object covers with Windows' own recogniser, and say when it changes"
msgstr "Obserwuj obszar tego obiektu rozpoznawaniem tekstu Windows i mów, gdy się zmieni"

#. Translators: an NVDA command.
#: __init__.py:1849
msgid "Watch this whole window with Windows' own recogniser, and say when it changes"
msgstr "Obserwuj całe to okno rozpoznawaniem tekstu Windows i mów, gdy się zmieni"

#. Translators: an NVDA command.
#: __init__.py:1857
msgid "What is being watched, and stop watching one"
msgstr "Co jest obserwowane - i przerwanie obserwacji wybranego"

#: __init__.py:1870
msgid "In a widget: up"
msgstr "W widżecie: w górę"

#: __init__.py:1874
msgid "In a widget: down"
msgstr "W widżecie: w dół"

#: __init__.py:1878
msgid "In a widget: left"
msgstr "W widżecie: w lewo"

#: __init__.py:1882
msgid "In a widget: right"
msgstr "W widżecie: w prawo"

#: __init__.py:1886
msgid "In a widget: press what you are on"
msgstr "W widżecie: naciśnij to, na czym jesteś"

#: __init__.py:1895
msgid "Leave the widget"
msgstr "Wyjdź z widżetu"

#. Translators: an NVDA command.
#: __init__.py:1907
msgid "Titan widgets: choose one and walk it"
msgstr "Widżety Titana: wybierz jeden i chodź po nim"

#: __init__.py:1924
msgid "In the virtual window: the control above"
msgstr "W wirtualnym oknie: kontrolka wyżej"

#: __init__.py:1929
msgid "In the virtual window: the control below"
msgstr "W wirtualnym oknie: kontrolka niżej"

#: __init__.py:1934
msgid "In the virtual window: back - a character of this control's text, the control beside it, or the control before it at this level, by layout"
msgstr "W wirtualnym oknie: wstecz - znak tekstu tej kontrolki, kontrolka obok lub poprzednia kontrolka na tym poziomie, zależnie od układu"

#: __init__.py:1941
msgid "In the virtual window: on - a character of this control's text, the control beside it, or the control after it at this level, by layout"
msgstr "W wirtualnym oknie: dalej - znak tekstu tej kontrolki, kontrolka obok lub następna kontrolka na tym poziomie, zależnie od układu"

#: __init__.py:1948
msgid "In the virtual window: the word before, in this control's text"
msgstr "W wirtualnym oknie: słowo przed tym, w tekście tej kontrolki"

#: __init__.py:1953
msgid "In the virtual window: the word after, in this control's text"
msgstr "W wirtualnym oknie: słowo za tym, w tekście tej kontrolki"

#: __init__.py:1958
msgid "In the virtual window: the other way back - the control beside this one in the simple layout, a character of its text in the others"
msgstr "W wirtualnym oknie: wstecz na drugi sposób - kontrolka obok w układzie prostym, znak jej tekstu w pozostałych"

#: __init__.py:1966
msgid "In the virtual window: the other way on - the control beside this one in the simple layout, a character of its text in the others"
msgstr "W wirtualnym oknie: dalej na drugi sposób - kontrolka obok w układzie prostym, znak jej tekstu w pozostałych"

#: __init__.py:1974
msgid "In the virtual window: the top left corner of the window"
msgstr "W wirtualnym oknie: lewy górny róg okna"

#: __init__.py:1979
msgid "In the virtual window: the top right corner of the window"
msgstr "W wirtualnym oknie: prawy górny róg okna"

#: __init__.py:1984
msgid "In the virtual window: the bottom left corner of the window"
msgstr "W wirtualnym oknie: lewy dolny róg okna"

#: __init__.py:1989
msgid "In the virtual window: the bottom right corner of the window"
msgstr "W wirtualnym oknie: prawy dolny róg okna"

#: __init__.py:1994
msgid "In the virtual window: click the control with the mouse - twice quickly for a double click"
msgstr "W wirtualnym oknie: kliknij kontrolkę myszą - dwa razy szybko, aby kliknąć podwójnie"

#: __init__.py:2015
msgid "In the virtual window: the next layout the arrows follow - simple, screen, interaction"
msgstr "W wirtualnym oknie: następny układ, za którym idą strzałki - prosty, ekranu, z interakcją"

#: __init__.py:2021
msgid "In the virtual window: the previous layout the arrows follow - simple, screen, interaction"
msgstr "W wirtualnym oknie: poprzedni układ, za którym idą strzałki - prosty, ekranu, z interakcją"

#: __init__.py:2027
msgid "In the virtual window: ten controls back"
msgstr "W wirtualnym oknie: dziesięć kontrolek wstecz"

#: __init__.py:2032
msgid "In the virtual window: ten controls on"
msgstr "W wirtualnym oknie: dziesięć kontrolek dalej"

#: __init__.py:2037
msgid "In the virtual window: the first control"
msgstr "W wirtualnym oknie: pierwsza kontrolka"

#: __init__.py:2042
msgid "In the virtual window: the last control"
msgstr "W wirtualnym oknie: ostatnia kontrolka"

#: __init__.py:2047
msgid "In the virtual window: click what you are on"
msgstr "W wirtualnym oknie: kliknij to, na czym jesteś"

#: __init__.py:2061
msgid "In the virtual window: the program's own Backspace - up one folder - and then build the window again"
msgstr "W wirtualnym oknie: Backspace programu - katalog wyżej - i zbudowanie okna od nowa"

#: __init__.py:2085
msgid "In the virtual window: build it again"
msgstr "W wirtualnym oknie: zbuduj je ponownie"

#: __init__.py:2095
msgid "Leave the virtual window, or the field being typed into"
msgstr "Wyjdź z wirtualnego okna lub z pola edycji"

#: __init__.py:2144
msgid "In the virtual window: the next button, heading, check box, list and so on - b, h, x, i, l, c, e, t, k, g, s, m, a, o"
msgstr "W wirtualnym oknie: następny przycisk, nagłówek, pole wyboru, lista i tak dalej - b, h, x, i, l, c, e, t, k, g, s, m, a, o"

#: __init__.py:2151
msgid "In the virtual window: the same, backwards"
msgstr "W wirtualnym oknie: to samo, wstecz"

#. Translators: an NVDA command.
#: __init__.py:2158
msgid "Walk this window as a virtual window of all its controls"
msgstr "Przeglądaj to okno jako wirtualne okno wszystkich jego kontrolek"

#. Translators: an NVDA command.
#: __init__.py:2169
msgid "TCE applications: open one and walk it with the arrow keys"
msgstr "Aplikacje TCE: otwórz jedną i chodź po niej strzałkami"

#: __init__.py:2188
msgid "In an application: the control above"
msgstr "W aplikacji: kontrolka wyżej"

#: __init__.py:2193
msgid "In an application: the control below"
msgstr "W aplikacji: kontrolka niżej"

#: __init__.py:2198
msgid "In an application: back through what is inside this control"
msgstr "W aplikacji: wstecz po zawartości tej kontrolki"

#: __init__.py:2204
msgid "In an application: on through what is inside this control"
msgstr "W aplikacji: dalej po zawartości tej kontrolki"

#: __init__.py:2210
msgid "In an application: ten controls back"
msgstr "W aplikacji: dziesięć kontrolek wstecz"

#: __init__.py:2215
msgid "In an application: ten controls on"
msgstr "W aplikacji: dziesięć kontrolek dalej"

#: __init__.py:2220
msgid "In an application: the first control"
msgstr "W aplikacji: pierwsza kontrolka"

#: __init__.py:2225
msgid "In an application: the last control"
msgstr "W aplikacji: ostatnia kontrolka"

#: __init__.py:2230
msgid "In an application: press what you are on"
msgstr "W aplikacji: naciśnij to, na czym jesteś"

#: __init__.py:2244
msgid "In an application: tick or untick what you are on"
msgstr "W aplikacji: zaznacz lub odznacz to, na czym jesteś"

#: __init__.py:2256
msgid "In an application: read the screen again"
msgstr "W aplikacji: odczytaj ekran ponownie"

#: __init__.py:2266
msgid "Leave the application review"
msgstr "Wyjdź z przeglądu aplikacji"

#. Translators: an NVDA command.
#: __init__.py:2296
msgid "TCE applications: show it as real controls instead"
